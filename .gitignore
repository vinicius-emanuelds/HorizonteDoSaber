# =============================================================================
# HORIZONTE DO SABER — .gitignore
# Spring Boot 3.x · Java 21 · Maven · PostgreSQL · Docker · Thymeleaf
# =============================================================================

# ─── Maven ───────────────────────────────────────────────────────────────────
target/
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# ─── Spring Boot / Application ───────────────────────────────────────────────
HELP.md
spring-shell.log
*.log
logs/
log/

# Configurações locais com segredos (use application-local.properties)
src/main/resources/application-local.properties
src/main/resources/application-local.yml
src/main/resources/application-dev.properties
src/main/resources/application-dev.yml
src/main/resources/application-prod.properties
src/main/resources/application-prod.yml
*.env
.env
.env.*

# ─── Java ────────────────────────────────────────────────────────────────────
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ─── Docker ──────────────────────────────────────────────────────────────────
.dockerignore
docker-compose.override.yml
docker-compose.local.yml

# ─── Windows ─────────────────────────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk
*.cab
*.msi
*.msix
*.msm
*.msp

# ─── IDEs: IntelliJ IDEA ─────────────────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# ─── IDEs: Eclipse / STS ─────────────────────────────────────────────────────
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# ─── IDEs: NetBeans ──────────────────────────────────────────────────────────
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ─── IDEs: VS Code ───────────────────────────────────────────────────────────
.vscode/
*.code-workspace

# ─── Sistemas de OS ──────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
